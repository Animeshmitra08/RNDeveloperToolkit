{
  "name": "rn-development-toolkit",
  "displayName": "RN Development Toolkit",
  "description": "Developer utilities for React Native and Expo",
  "publisher": "animeshmitra",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rnToolkitContainer",
          "title": "RN Toolkit",
          "icon": "resources/rn-toolkit.svg"
        }
      ]
    },
    "views": {
      "rnToolkitContainer": [
        {
          "id": "rnToolkitView",
          "name": "RN Developer Toolkit"
        }
      ]
    },
    "commands": [
      {
        "command": "rn-developer-toolkit.showProjectInfo",
        "title": "RN Toolkit: Analyze Project"
      },
      {
        "command": "rn-developer-toolkit.expoStart",
        "title": "RN Toolkit: Start Expo"
      },
      {
        "command": "rn-developer-toolkit.expoAndroid",
        "title": "RN Toolkit: Run Android"
      },
      {
        "command": "rn-developer-toolkit.expoIOS",
        "title": "RN Toolkit: Run iOS"
      },
      {
        "command": "rn-developer-toolkit.expoClearCache",
        "title": "RN Toolkit: Start Expo with Clear Cache"
      },
      {
        "command": "rn-developer-toolkit.expoDoctor",
        "title": "RN Toolkit: Expo Doctor"
      },
      {
        "command": "rn-developer-toolkit.expoFixDependencies",
        "title": "RN Toolkit: Fix Expo Dependencies"
      },
      {
        "command": "rn-developer-toolkit.expoPrebuildClean",
        "title": "RN Toolkit: Expo Prebuild (Clean)"
      },
      {
        "command": "rn-developer-toolkit.installPackage",
        "title": "RN Toolkit: Install Package"
      },
      {
        "command": "rn-developer-toolkit.easLogin",
        "title": "RN Toolkit: EAS Login"
      },
      {
        "command": "rn-developer-toolkit.easLogout",
        "title": "RN Toolkit: EAS Logout"
      },
      {
        "command": "rn-developer-toolkit.easWhoAmI",
        "title": "RN Toolkit: EAS Who Am I"
      },
      {
        "command": "rn-developer-toolkit.easInit",
        "title": "RN Toolkit: EAS Init Project"
      },
      {
        "command": "rn-developer-toolkit.easBuildConfigure",
        "title": "RN Toolkit: EAS Configure Build"
      },
      {
        "command": "rn-developer-toolkit.easBuild",
        "title": "RN Toolkit: EAS Build"
      },
      {
        "command": "rn-developer-toolkit.easBuildAndSubmit",
        "title": "RN Toolkit: EAS Build & Submit"
      },
      {
        "command": "rn-developer-toolkit.easSubmit",
        "title": "RN Toolkit: EAS Submit to Store"
      },
      {
        "command": "rn-developer-toolkit.easUpdate",
        "title": "RN Toolkit: EAS Publish OTA Update"
      },
      {
        "command": "rn-developer-toolkit.easBuildList",
        "title": "RN Toolkit: EAS Recent Builds"
      },
      {
        "command": "rn-developer-toolkit.easCredentials",
        "title": "RN Toolkit: EAS Manage Credentials"
      },
      {
        "command": "rn-developer-toolkit.generatorComingSoon",
        "title": "RN Toolkit: Generator Coming Soon"
      },
      {
        "command": "rn-developer-toolkit.runDoctor",
        "title": "RN Toolkit: Run Project Doctor"
      },
      {
        "command": "rn-developer-toolkit.createComponent",
        "title": "RN Toolkit: Create Component"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Animeshmitra08/RNDeveloperToolkit.git"
  },
  "homepage": "https://github.com/Animeshmitra08/RNDeveloperToolkit.git",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "license": "MIT"
}
